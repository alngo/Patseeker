@startuml
box "Interface"
  Actor Trader
end box

box "Application"
  participant SupervisorAppService
end box

box "Domain"
  participant Supervisor
  participant StructureAdvisor
  collections SignalAdvisors
end box

box "Infrastructure"
  database MarketDataFeed
  database StructureRepository
  database SignalRepository
end box

Trader -> SupervisorAppService: run_analysis(symbol, timeframe, lookback)

SupervisorAppService -> MarketDataFeed: retrieve_candles(symbol, timeframe, lookback)
MarketDataFeed --> SupervisorAppService: List<Candlestick>

SupervisorAppService -> StructureRepository: retrieve_structure(symbol, timeframe, from_date)
StructureRepository --> SupervisorAppService: List<Structure>

SupervisorAppService -> Supervisor: run_analysis(candles, old_structures)
Supervisor -> StructureAdvisor: evaluate(candles)
StructureAdvisor --> Supervisor: List<Structure>

Supervisor -> Supervisor: merge old + new structures
Supervisor -> SignalAdvisors: evaluate(candles)
SignalAdvisors --> Supervisor: List<Signal>

Supervisor --> SupervisorAppService: (structures, signals)

SupervisorAppService -> StructureRepository: save(structures)
SupervisorAppService -> SignalRepository: save(signals)

SupervisorAppService --> Trader: return (structures, signals)
@enduml
